<Project Sdk="Microsoft.NET.Sdk">

  <!--
    .NET version of the training listener, for the Windows VMs where Python is not
    installed. Behaviour and output match lab/listener/listener.py so the scorecard
    and ATTACK-GUIDE stay valid regardless of which listener you run.

    Uses a raw TcpListener bound to 127.0.0.1 so it needs no admin rights and no
    HTTP URL-ACL registration (which HttpListener on a specific IP would require).

    If your VM's .NET SDK is older than net10.0, change TargetFramework below to the
    installed version (e.g. net8.0); nothing here is version-specific.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>lab-listener</AssemblyName>
    <RootNamespace>LabListener</RootNamespace>
  </PropertyGroup>

</Project>
